  "comment_queue": {"max_visible": 3, "slot_height_px": 156, "avatar_size_px": 44, "regular_surface": "transparent", "priority_surface": "localized_glass", "presentation": "camera_overlay", "author_and_body_flow": "stacked", "motion_recipe": "waterfall-entry+nudge-curve", "entry_seconds": 0.24, "shift_seconds": 0.22, "exit_seconds": 0.18},
  "commerce": {"mode": "compact_pin", "width_px": 770, "height_px": 172, "forbid": ["invented_price", "stock_claim", "countdown", "purchase_cta"]},
  "qa": {"require_text_shadow_on_camera": true, "forbid_repeated_full_comment_cards": true, "forbid_face_or_product_occlusion": true},
  "training_eligible": false,
  "human_review": "pending"
}
