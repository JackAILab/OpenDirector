{
  "schema": "visualagent.live-text-style.v1",
  "id": "mobile-live-text-en-portrait-v4",
  "owner": "code_hyperframes",
  "locale": "en",
  "canvas": {"width": 1080, "height": 1920, "orientation": "portrait"},
  "research_basis": {"scope": "user-supplied English live-room screenshot and mobile hierarchy principles", "principles_only": true, "copied_brand_assets": false},
  "hierarchy": {"fixed_order": ["host_identity", "viewer_count", "action_rail", "comment_queue", "composer"], "event_order": ["commerce_card", "gift_notice"], "max_simultaneous_priority_surfaces": 1, "ordinary_comments_yield_to_priority_surface": true},
  "safe_areas": {"top_px": 34, "right_rail_width_px": 112, "comment_left_px": 34, "comment_bottom_px": 196, "composer_bottom_px": 40, "protected_subject_zone": {"x": 280, "y": 250, "width": 560, "height": 1100}},
  "text_roles": [
